#!/bin/bash
# Entry point for the Apple Reminders widget. Runs the Python helper inside a
# private venv (pyicloud is not packaged for Arch).
#
#   apple-reminders install   create/upgrade the venv
#   apple-reminders login     interactive Apple ID + 2FA sign-in
#   apple-reminders <cmd>     see apple_reminders.py

DATA_DIR="${APPLE_REMINDERS_DATA:-${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-apple-reminders}"
VENV="$DATA_DIR/venv"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYICLOUD_VERSION="2.7.0"

install_venv() {
  mkdir -p "$DATA_DIR" && chmod 700 "$DATA_DIR"
  [[ -x $VENV/bin/python ]] || python3 -m venv "$VENV" || return 1
  "$VENV/bin/pip" install -q --upgrade "pyicloud==$PYICLOUD_VERSION" rich
}

case "$1" in
install)
  install_venv && echo "Listo: $VENV"
  exit
  ;;
login)
  if [[ ! -x $VENV/bin/python ]]; then
    echo "Instalando pyicloud…"
    install_venv || exit 1
  fi
  exec "$VENV/bin/python" -I "$HERE/apple_reminders.py" login
  ;;
esac

if [[ ! -x $VENV/bin/python ]]; then
  echo '{"ok":false,"error":"not-installed","hint":"run: apple-reminders install"}'
  exit 0
fi

exec "$VENV/bin/python" -I "$HERE/apple_reminders.py" "$@"
